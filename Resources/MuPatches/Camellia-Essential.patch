@@ -786,6 +787,28 @@ GicV3DxeInitialize (
 
   mGicRedistributorBase = GicGetCpuRedistributorBase (PcdGet64 (PcdGicRedistributorsBase));
 
+  /*
+   * Camellia: Linux may leave this CPU's redistributor asleep and with the
+   * SGI/PPI frame configured; accesses to GICR_ISENABLER0 then never
+   * complete. Wake it and reset the private interrupt frame.
+   */
+  RegValue = MmioRead32 (mGicRedistributorBase + 0x0014); /* GICR_WAKER */
+  MmioWrite32 (mGicRedistributorBase + 0x0014, RegValue & ~(UINT32)(1 << 1));
+  while ((MmioRead32 (mGicRedistributorBase + 0x0014) & (1 << 2)) != 0) {
+    /* wait for ChildrenAsleep to clear */
+  }
+
+  /* Disable all SGIs/PPIs and give them the default priority. */
+  MmioWrite32 (mGicRedistributorBase + ARM_GICR_CTLR_FRAME_SIZE + ARM_GICR_ICENABLER, 0xffffffff);
+  MmioWrite32 (mGicRedistributorBase + ARM_GICR_CTLR_FRAME_SIZE + ARM_GICR_ICENABLER + 4, 0xffffffff);
+  MmioWrite32 (mGicRedistributorBase + ARM_GICR_CTLR_FRAME_SIZE + ARM_GICR_ICPENDR, 0xffffffff);
+  MmioWrite32 (mGicRedistributorBase + ARM_GICR_CTLR_FRAME_SIZE + ARM_GICR_ICPENDR + 4, 0xffffffff);
+  MmioWrite32 (mGicRedistributorBase + ARM_GICR_CTLR_FRAME_SIZE + ARM_GICR_ICACTIVER, 0xffffffff);
+  MmioWrite32 (mGicRedistributorBase + ARM_GICR_CTLR_FRAME_SIZE + ARM_GICR_ICACTIVER + 4, 0xffffffff);
+  for (Index = 0; Index < 32; Index++) {
+    MmioWrite8 (mGicRedistributorBase + ARM_GICR_CTLR_FRAME_SIZE + ARM_GIC_ICDIPR + Index, ARM_GIC_DEFAULT_PRIORITY);
+  }
+
   RegValue = ArmGicV3GetControlSystemRegisterEnable ();
   if ((RegValue & ICC_SRE_EL2_SRE) == 0) {
     ArmGicV3SetControlSystemRegisterEnable (RegValue | ICC_SRE_EL2_SRE);
